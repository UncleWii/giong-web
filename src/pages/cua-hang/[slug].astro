---
// Landing page của từng quán — trang đích quảng cáo Google / Facebook, mục tiêu chính: khách bấm "Chỉ đường tới quán".
// Nội dung lấy từ src/content/cua-hang.json (chữ trong [ngoặc vuông] là chỗ chưa có, điền tại file đó).
// Ảnh riêng từng quán: src/assets/cua-hang/<slug>/ (hero.webp, mon-1..4.webp, khong-gian-1..6.webp) — xem README ở đó.
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FloatingArtwork from "../../components/FloatingArtwork.astro";
import PhotoSlot from "../../components/PhotoSlot.astro";
import data from "../../content/cua-hang.json";
import { stores, storeImage, mapsUrl, embedUrl, storePath, hotlineOf, telHref, amenityLabel } from "../../lib/stores";

export function getStaticPaths() {
  return stores.map((store) => ({ params: { slug: store.slug }, props: { store } }));
}

const { store: s } = Astro.props;
const { labels } = data;
const maps = mapsUrl(s);
const tel = telHref(s);
const hotline = hotlineOf(s);
const others = stores.filter((o) => o.slug !== s.slug);
const heroShot = storeImage(s.image);
const dishes = (s.dishes ?? []).slice(0, 4);
const highlight = (id: string) => data.amenities.find((a) => a.id === id)?.highlight ?? amenityLabel(id);

const title = `${s.name} – Cà phê Việt tại ${s.shortAddress}, ${s.cityShort}`;
const description = `${s.name} – cà phê Việt tại ${s.shortAddress}, ${s.cityShort}. Mở cửa ${s.hours}. Hotline ${hotline}. Chỉ đường Google Maps, xem menu.`;

const og = await getImage({ src: heroShot, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });

const hours = s.hours.match(/(\d{1,2}:\d{2})\s*[–-]\s*(\d{1,2}:\d{2})/);
const pad = (t: string) => t.padStart(5, "0");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: s.name,
  description: s.description,
  image: new URL(og.src, Astro.site).toString(),
  url: new URL(storePath(s), Astro.site).toString(),
  telephone: hotline.replace(/[^+\d]/g, ""),
  hasMap: maps,
  address: { "@type": "PostalAddress", streetAddress: s.address, addressLocality: s.cityShort, addressCountry: "VN" },
  geo: { "@type": "GeoCoordinates", latitude: s.lat, longitude: s.lng },
  ...(hours && {
    openingHoursSpecification: {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      opens: pad(hours[1]),
      closes: pad(hours[2]),
    },
  }),
};

// Biểu tượng tiện ích (nét đơn giản, vẽ bằng stroke).
const amenityIcon: Record<string, string> = {
  outside: '<path d="M3 12a9 9 0 0 1 18 0H3Z"/><path d="M12 12v6.5a2 2 0 0 0 4 0"/>',
  pet: '<circle cx="6.5" cy="10" r="2"/><circle cx="10.5" cy="6.5" r="2"/><circle cx="15.5" cy="6.5" r="2"/><circle cx="19" cy="10" r="2"/><path d="M12.8 11.5c-3 0-5.3 3-5.3 5.2 0 2 2 2.3 5.3 2.3s5.3-.3 5.3-2.3c0-2.2-2.3-5.2-5.3-5.2Z"/>',
  ac: '<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/><path d="m9.5 4.5 2.5 2 2.5-2M9.5 19.5l2.5-2 2.5 2"/>',
  roastery: '<path d="M5 8h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V8Z"/><path d="M16 9h2a2.5 2.5 0 0 1 0 5h-2M8 3.5v2M12 3.5v2"/>',
};
---

<BaseLayout title={title} description={description} image={og.src} brandedTitle>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="lp" data-view-store data-chi-nhanh={s.trackId}>
    <!-- A. HERO: tên quán · trạng thái mở cửa · vị trí · nút Chỉ đường -->
    <section class="lp-hero">
      <div class="container lp-hero__inner">
        <a class="lp-en" href="#english" lang="en" aria-label="English information">EN</a>
        <div class="lp-hero__art">
          <FloatingArtwork />
        </div>
        <div class="lp-hero__copy">
          <p class="eyebrow">{s.city}</p>
          <h1 class="font-heading lp-hero__title">{s.h1}</h1>
          <p
            class="lp-status"
            data-open-status
            data-open={hours ? pad(hours[1]) : undefined}
            data-close={hours ? pad(hours[2]) : undefined}
          >
            <span class="lp-status__dot" aria-hidden="true"></span>
            <span data-status-text>{labels.hours}: {s.hours}</span>
          </p>
          <p class="lp-hint">{s.locationHint}</p>
          <div class="lp-hero__cta">
            <a
              class="big-btn big-btn--primary big-btn--xl"
              href={maps}
              target="_blank"
              rel="noopener noreferrer"
              data-track="click_chi_duong"
              data-chi-nhanh={s.trackId}
              data-vi-tri="hero"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                <circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.8" />
              </svg>
              <span>{labels.directions}</span>
            </a>
            <a class="big-btn big-btn--outline" href={tel} data-track="click_goi_chi_nhanh" data-chi-nhanh={s.trackId}>
              <span>{labels.call}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- B. ẢNH QUÁN LỚN + ĐIỂM NỔI BẬT -->
    <section class="container lp-sec lp-photo" aria-label="Ảnh quán">
      <PhotoSlot
        slug={s.slug}
        file="hero"
        label="hero quán"
        width={1600}
        height={1000}
        alt={`Không gian ${s.name}`}
        sizes="(min-width: 1320px) 1280px, 100vw"
        loading="eager"
      />
      {
        s.tags.length > 0 && (
          <ul class="lp-amenities" aria-label={labels.amenities}>
            {s.tags.map((t) => (
              <li>
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={amenityIcon[t]} />
                <span>{highlight(t)}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- C. ƯU ĐÃI CHO KHÁCH TỪ GOOGLE (ẩn nếu quán không có dữ liệu "offer") -->
    {
      s.offer && (
        <section class="container lp-sec" aria-labelledby="offer-title">
          <div class="lp-offer">
            <div class="lp-offer__text">
              <h2 id="offer-title" class="font-heading">{s.offer.title}</h2>
              <p>{s.offer.description}</p>
            </div>
            <div class="lp-offer__action">
              <button
                type="button"
                class="big-btn big-btn--ink"
                data-offer-btn
                data-track="lay_ma_uu_dai"
                data-chi-nhanh={s.trackId}
                aria-controls="offer-code"
                aria-expanded="false"
              >
                {labels.offerButton}
              </button>
              <div class="lp-offer__code" id="offer-code" hidden>
                <span>Đưa mã này cho nhân viên</span>
                <strong>{s.offer.code}</strong>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- D. MÓN ĐẶC TRƯNG -->
    {
      dishes.length > 0 && (
        <section class="container lp-sec" aria-labelledby="dishes-title">
          <h2 id="dishes-title" class="font-heading lp-h2">{labels.dishesTitle}</h2>
          <ul class="lp-dishes">
            {dishes.map((d, i) => (
              <li class="dish">
                <PhotoSlot
                  slug={s.slug}
                  file={`mon-${i + 1}`}
                  label="món"
                  width={800}
                  height={800}
                  alt={d.name}
                  sizes="(min-width: 900px) 300px, 45vw"
                />
                <h3 class="dish__name">{d.name}</h3>
                <p class="dish__price">{d.price}</p>
                <p class="dish__desc">{d.description}</p>
              </li>
            ))}
          </ul>
          <p class="lp-center">
            <a class="big-btn big-btn--outline" href="/menu" data-track="xem_menu" data-chi-nhanh={s.trackId}>
              <span>{labels.menuFull}</span>
            </a>
          </p>
        </section>
      )
    }

    <!-- E. KHÔNG GIAN QUÁN -->
    <section class="container lp-sec" aria-labelledby="space-title">
      <h2 id="space-title" class="font-heading lp-h2">{labels.spaceTitle}</h2>
      <ul class="lp-space">
        {
          [1, 2, 3, 4, 5, 6].map((n) => (
            <li>
              <PhotoSlot
                slug={s.slug}
                file={`khong-gian-${n}`}
                label="không gian"
                width={1200}
                height={900}
                alt={`${s.name} – không gian ${n}`}
                sizes="(min-width: 900px) 400px, 78vw"
                zoom
              />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- F. THÔNG TIN & BẢN ĐỒ -->
    <section class="container lp-sec" aria-labelledby="info-title">
      <h2 id="info-title" class="font-heading lp-h2">{labels.infoTitle}</h2>
      <div class="lp-info">
        <div>
          <dl class="lp-facts">
            <div>
              <dt>{labels.address}</dt>
              <dd>{s.address}</dd>
            </div>
            <div>
              <dt>{labels.hours}</dt>
              <dd>{s.hours}</dd>
            </div>
            <div>
              <dt>{labels.hotline}</dt>
              <dd><a href={tel} data-track="click_goi_chi_nhanh" data-chi-nhanh={s.trackId}>{hotline}</a></dd>
            </div>
          </dl>
          <div class="lp-cta">
            <a
              class="big-btn big-btn--primary"
              href={maps}
              target="_blank"
              rel="noopener noreferrer"
              data-track="click_chi_duong"
              data-chi-nhanh={s.trackId}
              data-vi-tri="thong_tin"
            >
              <span>{labels.directions}</span>
            </a>
            <a
              class="big-btn big-btn--outline"
              href={maps}
              target="_blank"
              rel="noopener noreferrer"
              data-track="xem_danh_gia"
              data-chi-nhanh={s.trackId}
            >
              <span>{labels.reviews}</span>
            </a>
          </div>
        </div>
        <div class="lp-map">
          <iframe data-src={embedUrl(s)} title={`Bản đồ ${s.name}`} referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          <noscript>
            <iframe src={embedUrl(s)} title={`Bản đồ ${s.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </noscript>
        </div>
      </div>
    </section>

    <!-- G. FOR INTERNATIONAL GUESTS -->
    <section class="container lp-sec" id="english" lang="en" aria-labelledby="en-title">
      <div class="lp-en-box">
        <p class="eyebrow">For international guests</p>
        <h2 id="en-title" class="font-heading">{s.name}</h2>
        <p class="lp-en-box__intro">{s.introEn}</p>
        <dl class="lp-facts">
          <div>
            <dt>Address</dt>
            <dd>{s.address}</dd>
          </div>
          <div>
            <dt>Opening hours</dt>
            <dd>{s.hours}</dd>
          </div>
        </dl>
        <div class="lp-cta">
          <a
            class="big-btn big-btn--primary"
            href={maps}
            target="_blank"
            rel="noopener noreferrer"
            data-track="click_chi_duong"
            data-chi-nhanh={s.trackId}
            data-vi-tri="en"
          >
            <span>Get directions</span>
          </a>
          <a class="big-btn big-btn--outline" href={tel} data-track="click_goi_chi_nhanh" data-chi-nhanh={s.trackId}>
            <span>Call</span>
          </a>
        </div>
      </div>
    </section>

    <!-- H. CÁC QUÁN GIÓNG KHÁC -->
    <nav class="container lp-sec" aria-labelledby="others-title">
      <h2 id="others-title" class="font-heading lp-h2">Các quán Gióng khác</h2>
      <ul class="lp-others">
        {
          others.map((o) => (
            <li>
              <a href={storePath(o)}>
                <Image src={storeImage(o.image)} alt="" widths={[240, 480]} sizes="(min-width: 900px) 240px, 45vw" loading="lazy" />
                <span class="lp-others__city">{o.cityShort}</span>
                <span class="lp-others__name">{o.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>

  <!-- I. THANH NÚT CỐ ĐỊNH ĐÁY MÀN HÌNH (chỉ điện thoại) -->
  <nav class="stickybar" aria-label="Thao tác nhanh">
    <a
      class="stickybar__btn stickybar__btn--primary"
      href={maps}
      target="_blank"
      rel="noopener noreferrer"
      data-track="click_chi_duong"
      data-chi-nhanh={s.trackId}
      data-vi-tri="thanh_day"
    >Chỉ đường</a>
    <a class="stickybar__btn" href={tel} data-track="click_goi_chi_nhanh" data-chi-nhanh={s.trackId}>Gọi</a>
    <a class="stickybar__btn" href="/menu" data-track="xem_menu" data-chi-nhanh={s.trackId}>Menu</a>
  </nav>

  <dialog class="lightbox" data-lightbox-dialog aria-label="Xem ảnh lớn">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Đóng">×</button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Ảnh trước">‹</button>
    <img alt="" data-lightbox-img />
    <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Ảnh sau">›</button>
  </dialog>
</BaseLayout>

<script>
  // Trạng thái mở cửa — tính theo giờ Việt Nam và giờ mở cửa của quán.
  const status = document.querySelector<HTMLElement>("[data-open-status]");
  if (status?.dataset.open && status.dataset.close) {
    const { open, close } = status.dataset as { open: string; close: string };
    const text = status.querySelector<HTMLElement>("[data-status-text]")!;
    const toMin = (t: string) => {
      const [h, m] = t.split(":").map(Number);
      return h * 60 + m;
    };
    const update = () => {
      const parts = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Ho_Chi_Minh",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
      }).formatToParts(new Date());
      const now = Number(parts.find((p) => p.type === "hour")?.value) * 60 + Number(parts.find((p) => p.type === "minute")?.value);
      const isOpen = now >= toMin(open) && now < toMin(close);
      status.dataset.state = isOpen ? "open" : "closed";
      text.textContent = isOpen ? `Đang mở cửa · đến ${close}` : `Đã đóng cửa · mở lại ${open}`;
    };
    update();
    window.setInterval(update, 60_000);
  }

  // Ưu đãi: bấm "Lấy mã ưu đãi" thì hiện mã (sự kiện lay_ma_uu_dai do module tracking gửi).
  const offerBtn = document.querySelector<HTMLButtonElement>("[data-offer-btn]");
  offerBtn?.addEventListener("click", () => {
    const code = document.getElementById("offer-code");
    if (!code) return;
    code.hidden = false;
    offerBtn.hidden = true;
    offerBtn.setAttribute("aria-expanded", "true");
    const value = code.querySelector("strong")?.textContent ?? "";
    navigator.clipboard?.writeText(value).catch(() => {});
  });

  // Bản đồ nhúng chỉ tải khi sắp cuộn tới (không tranh băng thông với ảnh và chữ ở màn hình đầu).
  const mapFrame = document.querySelector<HTMLIFrameElement>("iframe[data-src]");
  if (mapFrame) {
    const load = () => {
      mapFrame.src = mapFrame.dataset.src ?? "";
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            load();
            io.disconnect();
          }
        },
        { rootMargin: "300px 0px" }
      );
      io.observe(mapFrame);
    } else {
      load();
    }
  }

  // Xem ảnh không gian lớn.
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox-dialog]");
  const big = dialog?.querySelector<HTMLImageElement>("[data-lightbox-img]");
  const shots = Array.from(document.querySelectorAll<HTMLElement>("[data-lightbox]"));
  let current = 0;
  const show = (i: number) => {
    if (!dialog || !big || shots.length === 0) return;
    current = (i + shots.length) % shots.length;
    big.src = shots[current].dataset.full ?? "";
    big.alt = shots[current].dataset.alt ?? "";
  };
  shots.forEach((el, i) =>
    el.addEventListener("click", () => {
      show(i);
      dialog?.showModal();
    })
  );
  dialog?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
  dialog?.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(current - 1));
  dialog?.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(current + 1));
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
  });
</script>

<style>
  /* ---------- khung chung ---------- */
  .lp-sec {
    padding-block: var(--space-md);
  }

  .lp-h2 {
    font-size: var(--text-h2);
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .lp-center {
    margin-top: var(--space-sm);
    text-align: center;
  }

  /* ---------- nút ---------- */
  .big-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 56px;
    padding: 0.7em 1.6em;
    font: inherit;
    font-weight: 700;
    font-size: var(--text-body);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    border: var(--border-width) solid var(--color-primary);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .big-btn--xl {
    min-height: 64px;
    font-size: 1.1rem;
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }

  .big-btn--primary {
    color: var(--color-accent);
    background: var(--color-primary);
  }

  .big-btn--primary:hover,
  .big-btn--primary:focus-visible {
    color: var(--color-ink);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .big-btn--outline {
    color: var(--color-primary);
    background: transparent;
  }

  .big-btn--outline:hover,
  .big-btn--outline:focus-visible {
    color: var(--color-accent);
    background: var(--color-primary);
  }

  .big-btn--ink {
    color: var(--color-accent);
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .big-btn--ink:hover,
  .big-btn--ink:focus-visible {
    background: var(--color-primary-strong);
    border-color: var(--color-primary-strong);
  }

  /* ---------- A. hero ---------- */
  .lp-hero {
    background: var(--color-paper-deep);
    overflow: hidden;
  }

  .lp-hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-sm) var(--space-md);
  }

  .lp-en {
    position: absolute;
    top: var(--space-xs);
    right: var(--gutter);
    z-index: 1;
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 36px;
    padding-inline: 0.8em;
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    color: var(--color-primary);
    border: var(--border-width) solid var(--color-primary);
    border-radius: 999px;
  }

  .lp-en:hover,
  .lp-en:focus-visible {
    color: var(--color-accent);
    background: var(--color-primary);
  }

  /* Điện thoại: artwork nhỏ ở trên, nút Chỉ đường nằm trong màn hình đầu. */
  .lp-hero__art {
    width: min(58vw, 260px);
    margin-inline: auto;
  }

  .lp-hero__title {
    font-size: var(--text-h1);
    line-height: var(--leading-snug);
    color: var(--color-primary);
    margin-block: var(--space-3xs) var(--space-2xs);
  }

  .lp-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-weight: 700;
    font-size: var(--text-small);
    margin-bottom: var(--space-3xs);
  }

  .lp-status__dot {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: #9a9a92;
  }

  .lp-status[data-state="open"] .lp-status__dot {
    background: #2e9e4f;
    box-shadow: 0 0 0 4px color-mix(in srgb, #2e9e4f 25%, transparent);
  }

  .lp-status[data-state="closed"] .lp-status__dot {
    background: var(--color-primary);
  }

  .lp-hint {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .lp-hero__cta {
    display: grid;
    gap: var(--space-2xs);
  }

  /* ---------- B. ảnh lớn + tiện ích ---------- */
  .lp-photo {
    padding-top: var(--space-sm);
  }

  .lp-amenities {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
