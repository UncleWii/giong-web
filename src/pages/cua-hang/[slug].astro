---
// Trang quán tiếng Việt. Nội dung và bố cục nằm ở src/components/StorePage.astro (dùng chung với bản en / ko).
import StorePage from "../../components/StorePage.astro";
import { stores } from "../../lib/stores";

export function getStaticPaths() {
  return stores.map((store) => ({ params: { slug: store.slug }, props: { store } }));
}

const { store } = Astro.props;
---

<StorePage store={store} lang="vi" />
