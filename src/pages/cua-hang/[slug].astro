---
// Trang riêng của từng quán — trang đích cho quảng cáo Google Maps / Google Ads và SEO theo khu vực.
// Nội dung lấy từ src/content/cua-hang.json (cùng nguồn với danh sách /cua-hang).
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import data from "../../content/cua-hang.json";
import { storeImage, mapsUrl, embedUrl, storePath, hotlineOf, telHref, amenityLabel } from "../../lib/stores";

export function getStaticPaths() {
  return data.stores.map((store) => ({ params: { slug: store.slug }, props: { store } }));
}

const { store: s } = Astro.props;
const { labels } = data;
const image = storeImage(s.image);
const maps = mapsUrl(s);
const tel = telHref(s);
const hotline = hotlineOf(s);
const others = data.stores.filter((o) => o.slug !== s.slug);

const title = `${s.name} – Cà phê Việt tại ${s.shortAddress}, ${s.cityShort}`;
const description = `${s.name} – cà phê Việt tại ${s.shortAddress}, ${s.cityShort}. Mở cửa ${s.hours}. Hotline ${hotline}. Chỉ đường Google Maps, xem menu.`;

const og = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });

const hours = s.hours.match(/(\d{1,2}:\d{2})\s*[–-]\s*(\d{1,2}:\d{2})/);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  name: s.name,
  description: s.description,
  image: new URL(og.src, Astro.site).toString(),
  url: new URL(storePath(s), Astro.site).toString(),
  telephone: hotline.replace(/[^+\d]/g, ""),
  hasMap: maps,
  address: { "@type": "PostalAddress", streetAddress: s.address, addressLocality: s.cityShort, addressCountry: "VN" },
  geo: { "@type": "GeoCoordinates", latitude: s.lat, longitude: s.lng },
  ...(hours && {
    openingHoursSpecification: {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      opens: hours[1].padStart(5, "0"),
      closes: hours[2].padStart(5, "0"),
    },
  }),
};
---

<BaseLayout title={title} description={description} image={og.src} brandedTitle>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <PageHero image={image} eyebrow={s.city} title={s.h1} compact />

  <article class="shop container" data-view-store data-chi-nhanh={s.trackId}>
    <div class="shop__grid">
      <div class="shop__info">
        {
          s.tags.length > 0 && (
            <ul class="shop__tags" aria-label={labels.amenities}>
              {s.tags.map((t) => (
                <li>{amenityLabel(t)}</li>
              ))}
            </ul>
          )
        }
        <p class="shop__desc">{s.description}</p>

        <dl class="shop__facts">
          <div>
            <dt>{labels.address}</dt>
            <dd>{s.address}</dd>
          </div>
          <div>
            <dt>{labels.hours}</dt>
            <dd>{s.hours}</dd>
          </div>
          <div>
            <dt>{labels.hotline}</dt>
            <dd><a href={tel}>{hotline}</a></dd>
          </div>
        </dl>

        <div class="shop__cta">
          <a
            class="big-btn big-btn--primary"
            href={maps}
            target="_blank"
            rel="noopener noreferrer"
            data-track="click_chi_duong"
            data-chi-nhanh={s.trackId}
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              <circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.8" />
            </svg>
            <span>{labels.directions}</span>
          </a>
          <a class="big-btn big-btn--primary" href={tel} data-track="click_goi_chi_nhanh" data-chi-nhanh={s.trackId}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
            <span>{labels.call}</span>
          </a>
          <a
            class="big-btn big-btn--outline"
            href={maps}
            target="_blank"
            rel="noopener noreferrer"
            data-track="xem_danh_gia"
            data-chi-nhanh={s.trackId}
          >
            <span>{labels.reviews}</span>
          </a>
          <a class="big-btn big-btn--outline" href="/menu" data-track="xem_menu" data-chi-nhanh={s.trackId}>
            <span>{labels.menu}</span>
          </a>
        </div>
      </div>

      <div class="shop__map">
        <iframe
          src={embedUrl(s)}
          title={`Bản đồ ${s.name}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <section class="shop__en" lang="en" aria-labelledby="shop-en-title">
      <h2 id="shop-en-title" class="font-heading">{s.name}</h2>
      <dl class="shop__facts">
        <div>
          <dt>Address</dt>
          <dd>{s.address}</dd>
        </div>
        <div>
          <dt>Opening hours</dt>
          <dd>{s.hours}</dd>
        </div>
      </dl>
      <div class="shop__cta">
        <a
          class="big-btn big-btn--primary"
          href={maps}
          target="_blank"
          rel="noopener noreferrer"
          data-track="click_chi_duong"
          data-chi-nhanh={s.trackId}
        >
          <span>Get directions</span>
        </a>
        <a class="big-btn big-btn--outline" href={tel} data-track="click_goi_chi_nhanh" data-chi-nhanh={s.trackId}>
          <span>Call</span>
        </a>
      </div>
    </section>

    <nav class="shop__others" aria-label="Các quán Gióng khác">
      <h2 class="font-heading">Các quán Gióng khác</h2>
      <ul>
        {
          others.map((o) => (
            <li>
              <a href={storePath(o)}>{o.name} · {o.cityShort}</a>
            </li>
          ))
        }
        <li><a href="/cua-hang">Tất cả cửa hàng</a></li>
      </ul>
    </nav>
  </article>
</BaseLayout>

<style>
  .shop {
    padding-block: var(--space-lg) var(--space-xl);
  }

  .shop__grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }

  .shop__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-bottom: var(--space-xs);
  }

  .shop__tags li {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 0.2em 0.7em;
    color: var(--color-ink);
    background: var(--color-accent);
  }

  .shop__desc {
    font-size: var(--text-body-lg);
    margin-bottom: var(--space-sm);
  }

  .shop__facts {
    display: grid;
    gap: var(--space-2xs);
    margin-bottom: var(--space-sm);
  }

  .shop__facts dt {
    display: inline;
    font-weight: 700;
    margin-right: 0.3em;
  }

  .shop__facts dt::after {
    content: ":";
  }

  .shop__facts dd {
    display: inline;
    margin: 0;
  }

  .shop__facts a {
    color: inherit;
  }

  .shop__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .big-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    flex: 1 1 15rem;
    min-height: 56px;
    padding: 0.7em 1.4em;
    font-weight: 700;
    font-size: var(--text-body);
    text-align: center;
    text-decoration: none;
    border: var(--border-width) solid var(--color-primary);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .big-btn--primary {
    color: var(--color-accent);
    background: var(--color-primary);
  }

  .big-btn--primary:hover,
  .big-btn--primary:focus-visible {
    color: var(--color-ink);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .big-btn--outline {
    color: var(--color-primary);
    background: transparent;
  }

  .big-btn--outline:hover,
  .big-btn--outline:focus-visible {
    color: var(--color-accent);
    background: var(--color-primary);
  }

  .shop__map {
    min-height: 320px;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-bg-deep);
  }

  .shop__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 320px;
    border: 0;
  }

  .shop__en {
    margin-top: var(--space-lg);
    padding: var(--space-sm);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-left: 6px solid var(--color-primary);
  }

  .shop__en h2 {
    font-size: var(--text-h3);
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .shop__others {
    margin-top: var(--space-lg);
  }

  .shop__others h2 {
    font-size: var(--text-h3);
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .shop__others ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
  }

  .shop__others a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--color-primary);
  }

  @media (min-width: 900px) {
    .shop__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-lg);
      align-items: stretch;
    }

    .shop__map,
    .shop__map iframe {
      min-height: 460px;
    }
  }
</style>
