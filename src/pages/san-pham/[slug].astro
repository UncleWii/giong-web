---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShopeeButton from "../../components/ShopeeButton.astro";
import { products, formatPrice, noteIcon, productUrl } from "../../lib/products";
import sealIso from "../../assets/badges/Seal-ISO22000.webp";
import sealFda from "../../assets/badges/Seal-FDA.webp";
import sealOrganic from "../../assets/badges/Seal-VCO-Organic.webp";

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const notes = product.notes.map(cap);
const related = products.filter((p) => p.slug !== product.slug && p.category === product.category).slice(0, 3);
const others = related.length ? related : products.filter((p) => p.slug !== product.slug).slice(0, 3);

const description = [
  `${product.name} — ${product.seriesTitle} của Gióng.`,
  product.bean && `${product.bean}.`,
  notes.length && `Hương vị: ${notes.join(", ")}.`,
  `Giá ${formatPrice(product.price)} (đã gồm VAT).`,
  "Mua trên Shopee.",
]
  .filter(Boolean)
  .join(" ");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.story,
  brand: { "@type": "Brand", name: "Gióng" },
  category: product.seriesTitle,
  image: new URL(product.image.src, Astro.site).toString(),
  offers: {
    "@type": "Offer",
    priceCurrency: "VND",
    price: product.price,
    availability: "https://schema.org/InStock",
    url: product.shopeeUrl,
  },
};
---

<BaseLayout
  title={`${product.name} · ${product.seriesTitle}`}
  description={description}
  image={product.image.src}
  ogType="product"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article
    class="pdp container"
    data-view-item
    data-product-id={product.slug}
    data-product-name={product.name}
    data-category={product.category}
    data-price={product.price}
  >
    <nav class="pdp__crumbs" aria-label="Breadcrumb">
      <a href="/san-pham">Cà phê</a>
      <span aria-hidden="true">/</span>
      <span>{product.name}</span>
    </nav>

    <div class="pdp__grid">
      <div class="pdp__media">
        <Image
          src={product.image}
          alt={`Gói cà phê ${product.name}`}
          widths={[420, 640, 900]}
          sizes="(min-width: 900px) 40vw, 80vw"
          loading="eager"
        />
      </div>

      <div class="pdp__info">
        <p class="eyebrow">{product.seriesTitle}</p>
        <h1 class="font-heading pdp__title">{product.name}</h1>
        <p class="pdp__story">{product.story}</p>

        <dl class="pdp__facts">
          {product.bean && (
            <div>
              <dt>Hạt</dt>
              <dd>{product.bean}</dd>
            </div>
          )}
          {product.origin && (
            <div>
              <dt>Vùng trồng</dt>
              <dd>{product.origin}</dd>
            </div>
          )}
          {product.altitude && (
            <div>
              <dt>Độ cao</dt>
              <dd>{product.altitude}</dd>
            </div>
          )}
          {notes.length > 0 && (
            <div>
              <dt>Hương vị</dt>
              <dd>
                <ul class="notes">
                  {notes.map((n) => (
                    <li>
                      <span class="notes__icon" role="img" aria-label={n}>{noteIcon(n)}</span>
                      <span>{n}</span>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>

        {(product.certified || product.organic) && (
          <ul class="certs" aria-label="Chứng nhận">
            {product.certified && (
              <li>
                <Image src={sealIso} alt="Chứng nhận ISO 22000" widths={[120, 180, 240]} sizes="84px" />
              </li>
            )}
            {product.certified && (
              <li>
                <Image src={sealFda} alt="FDA Approved — Food and Drug Administration" widths={[120, 180, 240]} sizes="84px" />
              </li>
            )}
            {product.organic && (
              <li class="certs__organic">
                <Image src={sealOrganic} alt="Sản phẩm hữu cơ — Vietnam Certified Organic (VCO)" widths={[200, 300, 400]} sizes="168px" />
              </li>
            )}
          </ul>
        )}

        <p class="pdp__price">
          <span class="pdp__price-value">{formatPrice(product.price)}</span>
          <span class="pdp__vat">Giá đã bao gồm VAT</span>
        </p>

        <ShopeeButton product={product} />
      </div>
    </div>

    <section class="more" aria-labelledby="more-title">
      <h2 id="more-title" class="font-heading more__title">Có thể bạn cũng thích</h2>
      <ul class="more__grid">
        {
          others.map((o) => (
            <li>
              <a class="more__card" href={productUrl(o)}>
                <Image src={o.image} alt={`Gói cà phê ${o.name}`} widths={[200, 300]} sizes="160px" loading="lazy" />
                <span class="more__name">{o.name}</span>
                <span class="more__price">{formatPrice(o.price)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="more__all"><a href="/san-pham">Xem tất cả sản phẩm</a></p>
    </section>
  </article>
</BaseLayout>

<style>
  .pdp {
    padding-block: var(--space-md) var(--space-xl);
  }

  .pdp__crumbs {
    display: flex;
    gap: 0.6em;
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .pdp__crumbs a {
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .pdp__grid {
    display: grid;
    gap: var(--space-md);
    align-items: start;
  }

  .pdp__media {
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  .pdp__media :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .pdp__title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    color: var(--color-primary);
    margin-block: var(--space-3xs) var(--space-xs);
  }

  .pdp__story {
    font-size: var(--text-body-lg);
    max-width: 46ch;
    margin-bottom: var(--space-sm);
  }

  .pdp__facts {
    display: grid;
    gap: 0;
    margin-bottom: var(--space-sm);
    border-top: var(--border-width) solid var(--color-border);
  }

  .pdp__facts > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-xs);
    padding-block: var(--space-2xs);
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--text-body);
  }

  .pdp__facts dt {
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .pdp__facts dd {
    margin: 0;
  }

  .notes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
  }

  .notes li {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .notes__icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    font-size: 1.05rem;
    line-height: 1;
  }

  .certs {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .certs li {
    line-height: 0;
  }

  .certs :global(img) {
    width: 84px;
    height: auto;
  }

  .certs__organic :global(img) {
    width: 168px;
  }

  .pdp__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em var(--space-xs);
    margin-bottom: var(--space-sm);
  }

  .pdp__price-value {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: 700;
    color: var(--color-primary);
  }

  .pdp__vat {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .more {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--border-width) solid var(--color-border);
  }

  .more__title {
    font-size: var(--text-h3);
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .more__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    max-width: 640px;
  }

  .more__card {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    color: inherit;
    text-decoration: none;
  }

  .more__card :global(img) {
    width: 100%;
    height: auto;
  }

  .more__name {
    font-weight: 700;
    color: var(--color-primary);
  }

  .more__price {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .more__all {
    margin-top: var(--space-sm);
  }

  .more__all a {
    font-weight: 700;
    color: var(--color-primary);
  }

  @media (min-width: 900px) {
    .pdp__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-xl);
    }

    .pdp__media {
      margin-inline: 0;
      max-width: none;
    }
  }
</style>
