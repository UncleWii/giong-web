---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { images } from "../../lib/images";

const posts = (await getCollection("kienThuc", (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const fmt = new Intl.DateTimeFormat("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric" });
---

<BaseLayout
  pageCategory="kien_thuc"
  title="Kiến thức cà phê"
  description="Kiến thức cà phê từ Gióng: sự khác nhau giữa Arabica và Robusta, cà phê có bao nhiêu hương vị và nhiều hơn nữa."
>
  <PageHero image={images["giongfarm-127"]} eyebrow="Câu chuyện" title="Kiến thức cà phê" compact />

  <section class="list container" aria-label="Danh sách bài viết">
    <ul class="list__grid">
      {
        posts.map((p) => (
          <li class="post">
            <a class="post__link" href={`/kien-thuc-ca-phe/${p.id}`}>
              <div class="post__media">
                <Image
                  src={p.data.cover}
                  alt={p.data.coverAlt}
                  widths={[480, 768, 1080]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                  loading="lazy"
                />
              </div>
              <time class="post__date" datetime={p.data.date.toISOString()}>
                {fmt.format(p.data.date)}
              </time>
              <h2 class="font-heading post__title">{p.data.title}</h2>
              <p class="post__desc">{p.data.description}</p>
              <span class="post__more">Đọc bài viết</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .list {
    padding-block: var(--space-xl);
  }

  .list__grid {
    display: grid;
    gap: var(--space-lg) var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }

  .post__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .post__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    margin-bottom: var(--space-sm);
  }

  .post__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .post__link:hover .post__media :global(img) {
    transform: scale(1.03);
  }

  .post__date {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3xs);
  }

  .post__title {
    font-size: var(--text-h3);
    line-height: var(--leading-snug);
    color: var(--color-primary);
    margin-bottom: var(--space-2xs);
  }

  .post__desc {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .post__more {
    margin-top: auto;
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
    border-bottom: var(--border-width) solid currentColor;
    align-self: flex-start;
    padding-bottom: 0.2em;
  }

  @media (min-width: 640px) {
    .list__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .list__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
