---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Ribbon from "../components/Ribbon.astro";
import TextLink from "../components/TextLink.astro";
import PageActions from "../components/PageActions.astro";
import { images, type ImageSlug } from "../lib/images";
import data from "../content/cau-chuyen-giong.json";

const { hero, sections, cta } = data;

// Cụm "Rethink Robusta" trong bài dẫn sang dòng Robusta.
const RETHINK_TEXT = '"Rethink Robusta"';
const RETHINK = /("Rethink Robusta")/;
---

<BaseLayout
  pageCategory="cau_chuyen"
  title="Câu chuyện Gióng"
  description="Gióng Café ra đời từ tinh thần “Gióng trống mở cờ”: hành trình định vị cà phê thuần Việt, câu chuyện thương hiệu và triết lý High-quality Vietnamese Coffee & Rethink Robusta."
>
  <PageHero
    image={images[hero.image as ImageSlug]}
    eyebrow={hero.eyebrow}
    title={hero.title}
    compact
  />

  {
    sections.map((s, i) => (
      <section class:list={["block", { "block--reverse": i % 2 === 1 }]} aria-labelledby={`${s.id}-title`}>
        <Ribbon text={s.ribbon} />
        <div class="container block__grid">
          <div class="block__media">
            <Image
              src={images[s.image as ImageSlug]}
              alt={s.alt}
              widths={[480, 768, 1080, 1440]}
              sizes="(min-width: 900px) 50vw, 100vw"
              loading="lazy"
            />
          </div>
          <div class="block__text">
            <h2 id={`${s.id}-title`} class="font-heading block__title">{s.title}</h2>
            {s.body.map((p) =>
              p.startsWith("“") ? (
                <blockquote class="block__quote">{p}</blockquote>
              ) : (
                <p class="block__body">
                  {p.split(RETHINK).map((part) =>
                    part === RETHINK_TEXT ? <a class="inline-link" href="/san-pham#robusta">{part}</a> : part
                  )}
                </p>
              )
            )}
          </div>
        </div>
      </section>
    ))
  }

  <PageActions
    actions={[
      { label: "Ghé Gióng gần bạn", href: "/cua-hang", variant: "primary" },
      { label: "Thử Robusta Gióng", href: "/san-pham#robusta", variant: "secondary" },
    ]}
  />
  <p class="cta"><TextLink href={cta.href}>{cta.label}</TextLink></p>
</BaseLayout>

<style>
  .inline-link {
    color: var(--color-primary);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .block {
    padding-top: var(--space-xl);
  }

  .block__grid {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-md);
    align-items: start;
  }

  .block__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .block__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .block__title {
    font-size: var(--text-h2);
    line-height: var(--leading-snug);
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .block__body {
    margin-bottom: var(--space-xs);
    max-width: 60ch;
  }

  .block__quote {
    margin: var(--space-sm) 0;
    padding-left: var(--space-sm);
    border-left: 3px solid var(--color-accent);
    font-weight: 700;
    color: var(--color-primary);
    max-width: 52ch;
  }

  .cta {
    text-align: center;
    padding-block: var(--space-xl);
  }

  @media (min-width: 900px) {
    .block__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .block--reverse .block__media {
      order: 2;
    }
  }
</style>
