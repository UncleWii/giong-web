---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Ribbon from "../components/Ribbon.astro";
import TextLink from "../components/TextLink.astro";
import ShopeeButton from "../components/ShopeeButton.astro";
import { images, type ImageSlug } from "../lib/images";
import { getProduct, formatPrice, productUrl } from "../lib/products";
import data from "../content/san-pham.json";

const { hero, singleOrigin, tabs, horeca, comingSoon, labels, filters, detailLabel } = data;

// Danh sách sản phẩm đọc từ src/lib/products.ts (nguồn dữ liệu duy nhất).
const series = data.series.map((s) => ({ ...s, items: s.items.map(getProduct) }));
const instant = { ...data.instant, items: data.instant.items.map(getProduct) };

// Số sản phẩm cho từng bộ lọc (hiện cạnh tên bộ lọc).
const beanProducts = series.flatMap((s) => s.items);
const filterCount = (id: string) =>
  id === "all" ? beanProducts.length : beanProducts.filter((p) => p.filters.includes(id)).length;
---

<BaseLayout
  title="Cà phê"
  description="Cà phê hạt Single Origin rang mộc của Gióng: Robusta Series, Arabica Series, Classic Series; cà phê hòa tan, cà phê sỉ HORECA."
>
  <PageHero
    image={images[hero.image as ImageSlug]}
    title={hero.title}
    hideText
    compact
  />

  <section class="single container-narrow" aria-labelledby="single-title">
    <h2 id="single-title" class="font-heading single__title">{singleOrigin.title}</h2>
    <p class="single__text">{singleOrigin.text}</p>
  </section>

  <section class="catalog" data-tabs>
    <div class="container">
      <div class="tabs" role="tablist" aria-label="Nhóm sản phẩm">
        {
          tabs.map((t, i) => (
            <div class="tabs__item" role="presentation">
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                class="tabs__tab"
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                <span data-tab-label>{t.label}</span>
              </button>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 1. Cà phê hạt/bột -->
    <div role="tabpanel" id="panel-hat-bot" aria-labelledby="tab-hat-bot" class="panel">
      <div class="container">
        <div class="filterbar" data-filterbar>
          <p class="filterbar__title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 5h18l-7 8.5V20l-4-2v-4.5L3 5Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
            </svg>
            <span>Lọc theo dòng cà phê</span>
          </p>
          <div class="filterbar__chips" role="group" aria-label="Lọc cà phê hạt/bột theo dòng">
            {
              filters.map((f, fi) => (
                <button type="button" class="fchip" data-filter={f.id} aria-pressed={fi === 0 ? "true" : "false"}>
                  <span class="fchip__label">{f.label}</span>
                  <span class="fchip__n" aria-hidden="true">{filterCount(f.id)}</span>
                </button>
              ))
            }
          </div>
          <p class="filterbar__status" aria-live="polite">
            <span data-filter-status></span>
            <button type="button" class="filterbar__clear" data-filter-clear hidden>Xóa lọc</button>
          </p>
        </div>
      </div>
      {
        series.map((s) => (
          <section class="series" aria-label={s.title}>
            <Ribbon text={s.title} />
            <p class="series__intro">{s.intro}</p>
            <ul class="grid container">
              {s.items.map((it) => (
                <li class="card" data-filters={it.filters.join(" ")}>
                  <a class="card__link" href={productUrl(it)} aria-label={`${detailLabel}: ${it.name}`}>
                    <Image
                      class="card__img"
                      src={it.image}
                      alt={`Gói cà phê ${it.name}`}
                      widths={[240, 360, 540]}
                      sizes="(min-width: 900px) 22vw, 45vw"
                      loading="lazy"
                    />
                    <h3 class="font-heading card__name">{it.name}</h3>
                  </a>
                  <p class="card__story">{it.story}</p>
                  <dl class="card__meta">
                    <div><dt>{labels.bean}:</dt><dd>{it.bean}</dd></div>
                    <div><dt>{labels.notes}:</dt><dd>{it.notes.join(", ")}</dd></div>
                    <div><dt>{labels.price}:</dt><dd class="card__price">{formatPrice(it.price)}</dd></div>
                  </dl>
                  <div class="card__actions">
                    <ShopeeButton product={it} />
                    <a class="card__detail" href={productUrl(it)}>{detailLabel}</a>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <!-- 2. Cà phê hòa tan/túi lọc -->
    <div role="tabpanel" id="panel-hoa-tan" aria-labelledby="tab-hoa-tan" class="panel" hidden>
      <section class="series" aria-label={instant.title}>
        <Ribbon text={instant.title} />
        <ul class="grid grid--flat container">
          {
            instant.items.map((it) => (
              <li class="card">
                <a class="card__link" href={productUrl(it)} aria-label={`${detailLabel}: ${it.name}`}>
                  <Image
                    class="card__img"
                    src={it.image}
                    alt={it.name}
                    widths={[240, 360, 540]}
                    sizes="(min-width: 900px) 22vw, 45vw"
                    loading="lazy"
                  />
                  <h3 class="font-heading card__name">{it.name}</h3>
                </a>
                <p class="card__story">{it.story}</p>
                <dl class="card__meta">
                  <div><dt>{labels.price}:</dt><dd class="card__price">{formatPrice(it.price)}</dd></div>
                </dl>
                <div class="card__actions">
                  <ShopeeButton product={it} />
                  <a class="card__detail" href={productUrl(it)}>{detailLabel}</a>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- 3. HORECA, sỉ -->
    <div role="tabpanel" id="panel-horeca" aria-labelledby="tab-horeca" class="panel" hidden>
      <div class="container-narrow note">
        <h2 class="font-heading note__title">{horeca.title}</h2>
        <p>{horeca.text}</p>
        <TextLink href={horeca.href}>{horeca.cta}</TextLink>
      </div>
    </div>

    <!-- 4. Merchandise -->
    <div role="tabpanel" id="panel-merch" aria-labelledby="tab-merch" class="panel" hidden>
      <div class="container-narrow note">
        <h2 class="font-heading note__title">{tabs[3].label}</h2>
        <p>{comingSoon}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const options = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>("#panel-hat-bot .card"));
    const sections = Array.from(root.querySelectorAll<HTMLElement>("#panel-hat-bot .series"));
    const status = root.querySelector<HTMLElement>("[data-filter-status]");
    const clear = root.querySelector<HTMLButtonElement>("[data-filter-clear]");

    const applyFilter = (id: string) => {
      let shown = 0;
      cards.forEach((c) => {
        const ok = id === "all" || (c.dataset.filters ?? "").split(" ").includes(id);
        c.hidden = !ok;
        if (ok) shown++;
      });
      sections.forEach((sec) => {
        sec.hidden = !sec.querySelector(".card:not([hidden])");
      });
      options.forEach((o) => o.setAttribute("aria-pressed", String(o.dataset.filter === id)));
      if (status) {
        const label = options.find((o) => o.dataset.filter === id)?.querySelector(".fchip__label")?.textContent?.trim();
        status.textContent = id === "all" ? `Đang xem tất cả ${shown} sản phẩm` : `Đang lọc “${label}”: ${shown}/${cards.length} sản phẩm`;
      }
      if (clear) clear.hidden = id === "all";
    };

    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>("#" + t.getAttribute("aria-controls"));
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        const k = e.key;
        if (k === "ArrowRight") select(tabs[(i + 1) % tabs.length], true);
        else if (k === "ArrowLeft") select(tabs[(i - 1 + tabs.length) % tabs.length], true);
        else return;
        e.preventDefault();
      });
    });

    options.forEach((o) => o.addEventListener("click", () => applyFilter(o.dataset.filter ?? "all")));
    clear?.addEventListener("click", () => applyFilter("all"));

    const fromHash = tabs.find((t) => "#" + t.getAttribute("aria-controls") === location.hash);
    if (fromHash) select(fromHash);

    // /san-pham#robusta (hoặc #arabica, #blend, #organic) mở sẵn dòng tương ứng.
    const hashFilter = options.find((o) => o.dataset.filter === location.hash.slice(1));
    applyFilter(hashFilter?.dataset.filter ?? "all");
  });
</script>

<style>
  .single {
    padding-block: var(--space-lg) var(--space-md);
    text-align: center;
  }

  .single__title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .single__text {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
    max-width: 62ch;
    margin-inline: auto;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    padding-bottom: var(--space-md);
  }

  .tabs__tab {
    font: inherit;
    font-weight: 700;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    padding: 0.7em 1.3em;
    min-height: 44px;
    color: var(--color-primary);
    background: transparent;
    border: var(--border-width) solid var(--color-primary);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .tabs__tab:hover {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .tabs__tab[aria-selected="true"] {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .tabs__item {
    position: relative;
  }

  .tabs__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }

  .filterbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    max-width: 920px;
    margin: 0 auto var(--space-md);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-surface);
    border: var(--border-width) solid color-mix(in srgb, var(--color-primary) 35%, transparent);
    border-left: 6px solid var(--color-primary);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }

  .filterbar__title {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-weight: 700;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .filterbar__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .fchip {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font: inherit;
    font-weight: 700;
    font-size: var(--text-small);
    cursor: pointer;
    min-height: 44px;
    padding: 0.4em 0.5em 0.4em 1.1em;
    color: var(--color-primary);
    background: transparent;
    border: var(--border-width) solid var(--color-primary);
    border-radius: 999px;
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .fchip:hover {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .fchip[aria-pressed="true"] {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .fchip__n {
    display: inline-grid;
    place-items: center;
    min-width: 1.7em;
    height: 1.7em;
    padding-inline: 0.4em;
    font-size: 0.8em;
    border-radius: 999px;
    color: var(--color-paper);
    background: var(--color-primary);
  }

  .fchip[aria-pressed="true"] .fchip__n {
    color: var(--color-primary);
    background: var(--color-accent);
  }

  .filterbar__status {
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-xs);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .filterbar__clear {
    font: inherit;
    font-weight: 700;
    font-size: var(--text-small);
    cursor: pointer;
    padding: 0.2em 0.8em;
    color: var(--color-primary);
    background: transparent;
    border: var(--border-width) solid var(--color-primary);
    border-radius: 999px;
  }

  .filterbar__clear[hidden] {
    display: none;
  }

  .filterbar__clear:hover {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .card[hidden],
  .series[hidden] {
    display: none !important;
  }

  .panel[hidden] {
    display: none !important;
  }

  .series {
    padding-bottom: var(--space-lg);
    text-align: center;
  }

  .series__intro {
    max-width: 58ch;
    margin: var(--space-xs) auto var(--space-md);
    padding-inline: var(--gutter);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-sm);
    justify-content: start;
  }

  /* Mobile: every card is left-aligned, and both rows share the same left edge. */
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    min-width: 0;
  }

  .card__img {
    width: 100%;
    max-width: 300px;
    height: auto;
    margin-bottom: var(--space-xs);
  }

  .card__name {
    font-size: var(--text-h3);
    color: var(--color-primary);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-3xs);
  }

  .card__story {
    font-size: var(--text-small);
    margin-bottom: var(--space-xs);
  }

  .card__meta {
    display: grid;
    gap: var(--space-3xs);
    font-size: var(--text-small);
    margin-bottom: var(--space-sm);
  }

  .card__meta dt {
    display: inline;
    font-weight: 700;
    margin-right: 0.3em;
  }

  .card__meta dd {
    display: inline;
    margin: 0;
  }

  .card__price {
    font-weight: 700;
    color: var(--color-primary);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card__actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
  }

  .card__detail {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .note {
    text-align: center;
    padding-bottom: var(--space-xl);
  }

  .note__title {
    font-size: var(--text-h2);
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .note p {
    margin-bottom: var(--space-sm);
  }

  .grid--flat {
    margin-top: var(--space-lg);
  }

  @media (min-width: 900px) {
    /* Fixed 3 columns: a lone product (Blend, 3in1) sits in the first column like the first pack of other series. */
    .grid {
      grid-template-columns: repeat(3, 260px);
      justify-content: center;
      gap: var(--space-lg) clamp(3rem, 7vw, 6.5rem);
    }

    .grid--flat {
      margin-top: var(--space-xl);
    }
  }
</style>


