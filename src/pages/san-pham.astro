---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Ribbon from "../components/Ribbon.astro";
import TextLink from "../components/TextLink.astro";
import { images, type ImageSlug } from "../lib/images";
import data from "../content/san-pham.json";

const { hero, singleOrigin, tabs, series, instant, horeca, buyLabel, comingSoon, labels, filters } = data;
const buyHref = data.buyHref || "https://shopee.vn/";

const productFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/products/*.png", {
  eager: true,
});
const product = (slug: string) => productFiles[`../assets/products/${slug}.png`].default;
---

<BaseLayout
  title="Cà phê"
  description="Cà phê hạt Single Origin rang mộc của Gióng: Robusta Series, Arabica Series, Classic Series; cà phê hòa tan, cà phê sỉ HORECA."
>
  <PageHero
    image={images[hero.image as ImageSlug]}
    title={hero.title}
    hideText
    compact
  />

  <section class="single container-narrow" aria-labelledby="single-title">
    <h2 id="single-title" class="font-heading single__title">{singleOrigin.title}</h2>
    <p class="single__text">{singleOrigin.text}</p>
  </section>

  <section class="catalog" data-tabs>
    <div class="container">
      <div class="tabs" role="tablist" aria-label="Nhóm sản phẩm">
        {
          tabs.map((t, i) => (
            <div class="tabs__item" role="presentation">
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                class="tabs__tab"
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                aria-haspopup={i === 0 ? "true" : undefined}
                aria-expanded={i === 0 ? "false" : undefined}
              >
                <span data-tab-label>{t.label}</span>
                {i === 0 && (
                  <svg class="tabs__chev" width="12" height="8" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </button>
              {i === 0 && (
                <ul class="tabs__menu" data-filter-menu hidden aria-label="Lọc cà phê hạt/bột">
                  {filters.map((f, fi) => (
                    <li>
                      <button type="button" class="tabs__option" data-filter={f.id} aria-pressed={fi === 0 ? "true" : "false"}>
                        {f.label}
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <!-- 1. Cà phê hạt/bột -->
    <div role="tabpanel" id="panel-hat-bot" aria-labelledby="tab-hat-bot" class="panel">
      {
        series.map((s) => (
          <section class="series" aria-label={s.title}>
            <Ribbon text={s.title} />
            <p class="series__intro">{s.intro}</p>
            <ul class="grid container">
              {s.items.map((it) => (
                <li class="card" data-filters={it.filters.join(" ")}>
                  <Image
                    class="card__img"
                    src={product(it.image)}
                    alt={`Gói cà phê ${it.name}`}
                    widths={[240, 360, 540]}
                    sizes="(min-width: 900px) 22vw, 45vw"
                    loading="lazy"
                  />
                  <h3 class="font-heading card__name">{it.name}</h3>
                  <p class="card__story">{it.story}</p>
                  <dl class="card__meta">
                    <div><dt>{labels.bean}:</dt><dd>{it.bean}</dd></div>
                    <div><dt>{labels.notes}:</dt><dd>{it.notes}</dd></div>
                    <div><dt>{labels.price}:</dt><dd class="card__price">{it.price}.000đ</dd></div>
                  </dl>
                  <a class="buy" href={it.href || buyHref} target="_blank" rel="noopener noreferrer">
                    {buyLabel}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <!-- 2. Cà phê hòa tan/túi lọc -->
    <div role="tabpanel" id="panel-hoa-tan" aria-labelledby="tab-hoa-tan" class="panel" hidden>
      <section class="series" aria-label={instant.title}>
        <Ribbon text={instant.title} />
        <ul class="grid grid--flat container">
          {
            instant.items.map((it) => (
              <li class="card">
                <Image
                  class="card__img"
                  src={product(it.image)}
                  alt={it.name}
                  widths={[240, 360, 540]}
                  sizes="(min-width: 900px) 22vw, 45vw"
                  loading="lazy"
                />
                <h3 class="font-heading card__name">{it.name}</h3>
                <p class="card__story">{it.story}</p>
                <dl class="card__meta">
                  <div><dt>{labels.price}:</dt><dd class="card__price">{it.price}.000đ</dd></div>
                </dl>
                <a class="buy" href={it.href || buyHref} target="_blank" rel="noopener noreferrer">
                  {buyLabel}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- 3. HORECA, sỉ -->
    <div role="tabpanel" id="panel-horeca" aria-labelledby="tab-horeca" class="panel" hidden>
      <div class="container-narrow note">
        <h2 class="font-heading note__title">{horeca.title}</h2>
        <p>{horeca.text}</p>
        <TextLink href={horeca.href}>{horeca.cta}</TextLink>
      </div>
    </div>

    <!-- 4. Merchandise -->
    <div role="tabpanel" id="panel-merch" aria-labelledby="tab-merch" class="panel" hidden>
      <div class="container-narrow note">
        <h2 class="font-heading note__title">{tabs[3].label}</h2>
        <p>{comingSoon}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const menu = root.querySelector<HTMLElement>("[data-filter-menu]");
    const firstTab = tabs[0];
    const firstLabel = firstTab.querySelector<HTMLElement>("[data-tab-label]");
    const baseLabel = firstLabel?.textContent ?? "";
    const options = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>("#panel-hat-bot .card"));
    const sections = Array.from(root.querySelectorAll<HTMLElement>("#panel-hat-bot .series"));

    const setMenu = (open: boolean) => {
      if (!menu) return;
      menu.hidden = !open;
      firstTab.setAttribute("aria-expanded", String(open));
    };

    const applyFilter = (id: string, label: string) => {
      cards.forEach((c) => {
        c.hidden = id !== "all" && !(c.dataset.filters ?? "").split(" ").includes(id);
      });
      sections.forEach((sec) => {
        sec.hidden = !sec.querySelector(".card:not([hidden])");
      });
      options.forEach((o) => o.setAttribute("aria-pressed", String(o.dataset.filter === id)));
      if (firstLabel) firstLabel.textContent = id === "all" ? baseLabel : `${baseLabel} · ${label}`;
    };

    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>("#" + t.getAttribute("aria-controls"));
        if (panel) panel.hidden = !on;
      });
      if (tab !== firstTab) setMenu(false);
      if (focus) tab.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", (e) => {
        if (tab === firstTab) {
          e.stopPropagation();
          const wasSelected = tab.getAttribute("aria-selected") === "true";
          select(tab);
          setMenu(!wasSelected || menu?.hidden === true);
        } else {
          select(tab);
        }
      });
      tab.addEventListener("keydown", (e) => {
        const k = e.key;
        if (k === "ArrowRight") select(tabs[(i + 1) % tabs.length], true);
        else if (k === "ArrowLeft") select(tabs[(i - 1 + tabs.length) % tabs.length], true);
        else return;
        e.preventDefault();
      });
    });

    options.forEach((o) =>
      o.addEventListener("click", () => {
        applyFilter(o.dataset.filter ?? "all", o.textContent?.trim() ?? "");
        setMenu(false);
        firstTab.focus();
      })
    );
    document.addEventListener("click", (e) => {
      if (menu && !menu.hidden && !menu.contains(e.target as Node)) setMenu(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu && !menu.hidden) {
        setMenu(false);
        firstTab.focus();
      }
    });

    const fromHash = tabs.find((t) => "#" + t.getAttribute("aria-controls") === location.hash);
    if (fromHash) select(fromHash);
  });
</script>

<style>
  .single {
    padding-block: var(--space-lg) var(--space-md);
    text-align: center;
  }

  .single__title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .single__text {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
    max-width: 62ch;
    margin-inline: auto;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    padding-bottom: var(--space-md);
  }

  .tabs__tab {
    font: inherit;
    font-weight: 700;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    padding: 0.7em 1.3em;
    min-height: 44px;
    color: var(--color-primary);
    background: transparent;
    border: var(--border-width) solid var(--color-primary);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .tabs__tab:hover {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .tabs__tab[aria-selected="true"] {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .tabs__item {
    position: relative;
  }

  .tabs__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }

  .tabs__chev {
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .tabs__tab[aria-expanded="true"] .tabs__chev {
    transform: rotate(180deg);
  }

  .tabs__menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: 10;
    min-width: 100%;
    padding-block: var(--space-3xs);
    background: var(--color-paper);
    border: var(--border-width) solid var(--color-primary);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
  }

  .tabs__menu[hidden] {
    display: none;
  }

  .tabs__option {
    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    font-weight: 700;
    font-size: var(--text-small);
    min-height: 44px;
    padding: 0.5em 1.2em;
    cursor: pointer;
    color: var(--color-primary);
    background: transparent;
    border: none;
    white-space: nowrap;
  }

  .tabs__option:hover {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .tabs__option[aria-pressed="true"] {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .card[hidden],
  .series[hidden] {
    display: none !important;
  }

  .panel[hidden] {
    display: none !important;
  }

  .series {
    padding-bottom: var(--space-lg);
    text-align: center;
  }

  .series__intro {
    max-width: 58ch;
    margin: var(--space-xs) auto var(--space-md);
    padding-inline: var(--gutter);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-sm);
    justify-content: start;
  }

  /* Mobile: every card is left-aligned, and both rows share the same left edge. */
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    min-width: 0;
  }

  .card__img {
    width: 100%;
    max-width: 300px;
    height: auto;
    margin-bottom: var(--space-xs);
  }

  .card__name {
    font-size: var(--text-h3);
    color: var(--color-primary);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-3xs);
  }

  .card__story {
    font-size: var(--text-small);
    margin-bottom: var(--space-xs);
  }

  .card__meta {
    display: grid;
    gap: var(--space-3xs);
    font-size: var(--text-small);
    margin-bottom: var(--space-sm);
  }

  .card__meta dt {
    display: inline;
    font-weight: 700;
    margin-right: 0.3em;
  }

  .card__meta dd {
    display: inline;
    margin: 0;
  }

  .card__price {
    font-weight: 700;
    color: var(--color-primary);
  }

  .buy {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.6em 1.8em;
    font-weight: 700;
    font-size: var(--text-small);
    text-decoration: none;
    background: var(--color-accent);
    color: var(--color-ink);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .buy:hover {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .note {
    text-align: center;
    padding-bottom: var(--space-xl);
  }

  .note__title {
    font-size: var(--text-h2);
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .note p {
    margin-bottom: var(--space-sm);
  }

  .grid--flat {
    margin-top: var(--space-lg);
  }

  @media (min-width: 900px) {
    /* Fixed 3 columns: a lone product (Blend, 3in1) sits in the first column like the first pack of other series. */
    .grid {
      grid-template-columns: repeat(3, 260px);
      justify-content: center;
      gap: var(--space-lg) clamp(3rem, 7vw, 6.5rem);
    }

    .grid--flat {
      margin-top: var(--space-xl);
    }
  }
</style>


