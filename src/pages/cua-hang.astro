---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { images, type ImageSlug } from "../lib/images";
import data from "../content/cua-hang.json";

const { hero, cities, amenities, stores, labels, hotlineFallback } = data;

const storeFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/Giong-caphe-cuahang-*.{jpg,png}",
  { eager: true }
);
const storeImage = (name: string) => storeFiles[`../assets/images/${name}`].default;
const mapsUrl = (address: string, direct?: string) =>
  direct ||
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Gióng Cà phê, " + address)}`;
const amenityLabel = (id: string) => amenities.find((a) => a.id === id)?.label ?? id;
const cityCount = (c: string) => stores.filter((s) => s.city === c).length;
const amenityCount = (id: string) => stores.filter((s) => s.tags.includes(id)).length;
---

<BaseLayout
  title="Cửa hàng"
  description="Hệ thống cửa hàng Gióng tại Hồ Chí Minh, Hà Nội, Hội An và Nha Trang: địa chỉ, hotline, giờ mở cửa và chỉ đường Google Maps."
>
  <PageHero
    image={images[hero.image as ImageSlug]}
    title={hero.title}
    subtitle={hero.subtitle}
    compact
  />

  <section class="stores container" data-store-filter>
    <div class="filters">
      <div class="filters__head">
        <p class="filters__title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 5h18l-7 8.5V20l-4-2v-4.5L3 5Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
          </svg>
          <span>Lọc cửa hàng</span>
        </p>
        <p class="stores__count" aria-live="polite" data-count></p>
        <button type="button" class="filters__clear" data-clear hidden>Xóa bộ lọc</button>
      </div>

      <div class="filters__body">
        <div class="filters__group" role="group" aria-label={labels.cityGroup}>
          <p class="filters__label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
              <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.9" />
            </svg>
            {labels.cityGroup}
          </p>
          <div class="filters__chips">
            <button type="button" class="chip" data-city="" aria-pressed="true" data-track="loc_thanh_pho" data-thanh-pho="tat_ca">
              <span>{labels.all}</span><span class="chip__n" aria-hidden="true">{stores.length}</span>
            </button>
            {
              cities.map((c) => (
                <button type="button" class="chip" data-city={c} aria-pressed="false" data-track="loc_thanh_pho" data-thanh-pho={c}>
                  <span>{c}</span><span class="chip__n" aria-hidden="true">{cityCount(c)}</span>
                </button>
              ))
            }
          </div>
        </div>
        <div class="filters__group" role="group" aria-label={labels.amenityGroup}>
          <p class="filters__label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.9" />
              <path d="m8 12.4 2.8 2.8L16 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {labels.amenityGroup} <span class="filters__hint">(chọn được nhiều)</span>
          </p>
          <div class="filters__chips">
            {
              amenities.map((a) => (
                <button type="button" class="chip chip--amenity" data-amenity={a.id} aria-pressed="false">
                  <svg class="chip__tick" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{a.label}</span><span class="chip__n" aria-hidden="true">{amenityCount(a.id)}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <ul class="grid">
      {
        stores.map((s) => (
          <li class="store" data-city={s.city} data-tags={s.tags.join(" ")}>
            <div class="store__media">
              <Image
                src={storeImage(s.image)}
                alt={`Cửa hàng ${s.name}`}
                widths={[480, 768, 1080]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                loading="lazy"
              />
            </div>
            <div class="store__body">
              <p class="eyebrow store__city">{s.city}</p>
              <h2 class="font-heading store__name">{s.name}</h2>
              {s.tags.length > 0 && (
                <ul class="store__tags" aria-label="Tiện ích">
                  {s.tags.map((t) => (
                    <li>{amenityLabel(t)}</li>
                  ))}
                </ul>
              )}
              <p class="store__desc">{s.description}</p>
              <dl class="store__info">
                <div>
                  <dt>Địa chỉ</dt>
                  <dd>{s.address}</dd>
                </div>
                <div>
                  <dt>{labels.hotline}</dt>
                  <dd>
                    <a href={`tel:${(s.hotline || hotlineFallback).replace(/[^+\d]/g, "")}`}>
                      {s.hotline || hotlineFallback}
                    </a>
                  </dd>
                </div>
                <div>
                  <dt>{labels.hours}</dt>
                  <dd>{s.hours}</dd>
                </div>
              </dl>
              <div class="store__actions">
                <a
                  class="store__map"
                  href={mapsUrl(s.address, s.mapUrl)}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${labels.map}: ${s.name}`}
                  data-track="click_chi_duong"
                  data-chi-nhanh={s.trackId}
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linejoin="round"
                    />
                    <circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.8" />
                  </svg>
                  <span>{labels.directions}</span>
                  <svg class="store__map-arrow" width="16" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
                    <path d="M1 6H17M17 6L12 1M17 6L12 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <a
                  class="store__btn"
                  href={`tel:${(s.hotline || hotlineFallback).replace(/[^+\d]/g, "")}`}
                  aria-label={`${labels.call} ${s.name}`}
                  data-track="click_goi_chi_nhanh"
                  data-chi-nhanh={s.trackId}
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                  </svg>
                  <span>{labels.call}</span>
                </a>
                <a
                  class="store__btn"
                  href="/menu"
                  aria-label={`${labels.menu} của ${s.name}`}
                  data-track="xem_menu"
                  data-chi-nhanh={s.trackId}
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                    <path d="M9 9h6M9 13h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                  <span>{labels.menu}</span>
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="stores__empty" data-empty hidden>{labels.empty}</p>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-store-filter]").forEach((root) => {
    const cityBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-city].chip"));
    const amenityBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-amenity]"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>(".store"));
    const count = root.querySelector<HTMLElement>("[data-count]");
    const empty = root.querySelector<HTMLElement>("[data-empty]");
    const clear = root.querySelector<HTMLButtonElement>("[data-clear]");
    let city = "";
    const on = new Set<string>();

    const apply = () => {
      let shown = 0;
      cards.forEach((c) => {
        const tags = (c.dataset.tags ?? "").split(" ");
        const ok =
          (!city || c.dataset.city === city) && [...on].every((a) => tags.includes(a));
        c.hidden = !ok;
        if (ok) shown++;
      });
      const filtered = !!city || on.size > 0;
      if (count) count.textContent = filtered ? `Hiển thị ${shown}/${cards.length} cửa hàng` : `${shown} cửa hàng`;
      if (clear) clear.hidden = !filtered;
      if (empty) empty.hidden = shown > 0;
    };

    cityBtns.forEach((b) =>
      b.addEventListener("click", () => {
        city = b.dataset.city ?? "";
        cityBtns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        apply();
      })
    );
    amenityBtns.forEach((b) =>
      b.addEventListener("click", () => {
        const id = b.dataset.amenity!;
        on.has(id) ? on.delete(id) : on.add(id);
        b.setAttribute("aria-pressed", String(on.has(id)));
        apply();
      })
    );
    clear?.addEventListener("click", () => {
      city = "";
      on.clear();
      cityBtns.forEach((x) => x.setAttribute("aria-pressed", String(x.dataset.city === "")));
      amenityBtns.forEach((x) => x.setAttribute("aria-pressed", "false"));
      apply();
    });
    apply();
  });
</script>

<style>
  .stores {
    padding-block: var(--space-lg) var(--space-xl);
  }

  .filters {
    margin-bottom: var(--space-md);
    background: var(--color-surface);
    border: var(--border-width) solid color-mix(in srgb, var(--color-primary) 35%, transparent);
    border-left: 6px solid var(--color-primary);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }

  .filters__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .filters__title {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-weight: 700;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .filters__clear {
    margin-left: auto;
    font: inherit;
    font-weight: 700;
    font-size: var(--text-small);
    cursor: pointer;
    min-height: 36px;
    padding: 0.2em 1em;
    color: var(--color-primary);
    background: transparent;
    border: var(--border-width) solid var(--color-primary);
    border-radius: 999px;
  }

  .filters__clear[hidden] {
    display: none;
  }

  .filters__clear:hover {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .filters__body {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-sm);
  }

  .filters__label {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2xs);
  }

  .filters__hint {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }

  .filters__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font: inherit;
    font-weight: 700;
    font-size: var(--text-small);
    cursor: pointer;
    min-height: 44px;
    padding: 0.4em 0.5em 0.4em 1.1em;
    color: var(--color-primary);
    background: transparent;
    border: var(--border-width) solid var(--color-primary);
    border-radius: 999px;
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .chip--amenity {
    padding-left: 0.7em;
  }

  .chip__tick {
    display: none;
  }

  .chip[aria-pressed="true"] .chip__tick {
    display: block;
  }

  .chip:hover {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .chip[aria-pressed="true"] {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .chip__n {
    display: inline-grid;
    place-items: center;
    min-width: 1.7em;
    height: 1.7em;
    padding-inline: 0.4em;
    font-size: 0.8em;
    border-radius: 999px;
    color: var(--color-paper);
    background: var(--color-primary);
  }

  .chip[aria-pressed="true"] .chip__n {
    color: var(--color-primary);
    background: var(--color-accent);
  }

  .stores__count {
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .grid {
    display: grid;
    gap: var(--space-lg) var(--space-md);
    grid-template-columns: minmax(0, 1fr);
  }

  .store[hidden] {
    display: none !important;
  }

  .store {
    display: flex;
    flex-direction: column;
  }

  .store__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: var(--space-sm);
  }

  .store__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .store__body {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .store__name {
    font-size: var(--text-h3);
    line-height: var(--leading-snug);
    color: var(--color-primary);
    margin-block: var(--space-3xs) var(--space-2xs);
  }

  .store__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-bottom: var(--space-2xs);
  }

  .store__tags li {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 0.2em 0.7em;
    color: var(--color-ink);
    background: var(--color-accent);
  }

  .store__desc {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .store__info {
    display: grid;
    margin-bottom: var(--space-sm);
    gap: var(--space-3xs);
    font-size: var(--text-small);
  }

  .store__info dt {
    display: inline;
    font-weight: 700;
    margin-right: 0.3em;
  }

  .store__info dt::after {
    content: ":";
  }

  .store__info dd {
    display: inline;
    margin: 0;
  }

  .store__info a {
    color: inherit;
  }

  .store__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: auto;
  }

  .store__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 44px;
    padding: 0.5em 1.1em;
    font-weight: 700;
    font-size: var(--text-small);
    text-decoration: none;
    color: var(--color-primary);
    background: transparent;
    border: var(--border-width) solid var(--color-primary);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .store__btn:hover,
  .store__btn:focus-visible {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .store__map {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-2xs);
    min-height: 44px;
    padding: 0.5em 1.3em;
    font-weight: 700;
    font-size: var(--text-small);
    text-decoration: none;
    color: var(--color-accent);
    background: var(--color-primary);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .store__map:hover {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  .store__map-arrow {
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .store__map:hover .store__map-arrow {
    transform: translateX(3px);
  }

  .stores__empty {
    text-align: center;
    padding-block: var(--space-lg);
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl) var(--space-lg);
    }

    .filters__body {
      grid-template-columns: auto 1fr;
      gap: var(--space-lg);
    }
  }
</style>
