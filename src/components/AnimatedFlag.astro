---
import { getImage } from "astro:assets";
import { images } from "../lib/images";

const optimized = await getImage({
  src: images["thienly-camco"],
  width: 720,
  format: "webp",
});

// Region of the artwork (in % of its width/height) that holds the flag cloth and the
// top of the pole. Only this window is animated; the rest of the picture stays still.
const WIN_X0 = 6;
const WIN_X1 = 76;
const WIN_H = 44;
// Cloth is pinned to the pole on the right; strips left of ANCHOR_X wave more the further they are.
const ANCHOR_X = 61;
const FREE_END_X = 8;
const MAX_AMP = 1.6; // % of artwork height
const WAVE_DELAY = 2.6; // seconds of phase between pole and free end
const STRIPS = 24;

const stripW = (WIN_X1 - WIN_X0) / STRIPS;
const strips = Array.from({ length: STRIPS }, (_, i) => {
  const x0 = WIN_X0 + i * stripW;
  const x1 = Math.min(WIN_X1, x0 + stripW + 0.25);
  const centre = x0 + stripW / 2;
  const t = Math.min(1, Math.max(0, (ANCHOR_X - centre) / (ANCHOR_X - FREE_END_X)));
  return {
    x0: x0.toFixed(3),
    x1: x1.toFixed(3),
    amp: (MAX_AMP * Math.pow(t, 1.3)).toFixed(3),
    delay: (-(WAVE_DELAY * t)).toFixed(3),
  };
});
---

<div class="flag-box" aria-hidden="true" style={`--src: url("${optimized.src}"); --win-h: ${WIN_H}%;`}>
  <div class="flag">
    <div
      class="flag__base"
      style={`clip-path: polygon(evenodd, 0 0, 100% 0, 100% 100%, 0 100%, 0 0, ${WIN_X0}% 0, ${WIN_X0}% ${WIN_H}%, ${WIN_X1}% ${WIN_H}%, ${WIN_X1}% 0, ${WIN_X0}% 0);`}
    >
    </div>
    {
      strips.map((s) => (
        <div
          class="flag__strip"
          style={`--amp: ${s.amp}%; animation-delay: ${s.delay}s; clip-path: polygon(${s.x0}% 0, ${s.x1}% 0, ${s.x1}% ${WIN_H}%, ${s.x0}% ${WIN_H}%);`}
        >
        </div>
      ))
    }
  </div>
</div>

<style>
  .flag-box {
    position: absolute;
    inset: 0;
    container-type: size;
    pointer-events: none;
  }

  .flag {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(100cqw, calc(100cqh * 1828 / 2508));
    aspect-ratio: 1828 / 2508;
  }

  .flag__base,
  .flag__strip {
    position: absolute;
    inset: 0;
    background-image: var(--src);
    background-size: 100% 100%;
    background-repeat: no-repeat;
  }

  .flag__strip {
    animation: flag-wave 3.4s ease-in-out infinite;
  }

  @keyframes flag-wave {
    0%,
    100% {
      transform: translateY(calc(var(--amp) * -1));
    }
    50% {
      transform: translateY(var(--amp));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flag__strip {
      animation: none;
    }
  }
</style>
