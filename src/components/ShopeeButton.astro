---
// Nút "Mua trên Shopee" dùng chung (danh sách sản phẩm, trang sản phẩm…).
// Mọi thông tin đo lường (data-*) lấy từ src/lib/products.ts.
import { dongSanPham, type Product } from "../lib/products";

interface Props {
  product: Product;
  class?: string;
  /** Chỉ dùng ở trang quán: đo xem khách mua từ quán nào (chi_nhanh). vi_tri do khối chứa nút (data-vi-tri) hoặc đường dẫn trang quyết định. */
  chiNhanh?: string;
  /** Chữ trên nút và nhãn đọc màn hình (mặc định tiếng Việt). */
  label?: string;
  ariaLabel?: string;
}

const { product, class: className = "", chiNhanh, label = "Mua trên Shopee", ariaLabel = `Mua ${product.name} trên Shopee` } = Astro.props;
---

<a
  class:list={["shopee-btn", className]}
  href={product.shopeeUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  data-track="click_mua_ngay"
  data-product-id={product.slug}
  data-product-name={product.name}
  data-category={product.category}
  data-price={product.price}
  data-dong-san-pham={dongSanPham(product)}
  data-chi-nhanh={chiNhanh}
>
  <svg class="shopee-btn__icon" width="18" height="18" viewBox="0 0 44 44" aria-hidden="true">
    <rect width="44" height="44" rx="10" fill="#EE4D2D"></rect>
    <path d="M14 17h16l-1.2 12a2 2 0 0 1-2 1.8H17.2a2 2 0 0 1-2-1.8L14 17Z" fill="none" stroke="#fff" stroke-width="2.4" stroke-linejoin="round"></path>
    <path d="M18 17v-1.5a4 4 0 0 1 8 0V17" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  .shopee-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    min-height: 44px;
    padding: 0.6em 1.5em;
    font-weight: 700;
    font-size: var(--text-small);
    text-decoration: none;
    background: var(--color-accent);
    color: var(--color-ink);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .shopee-btn:hover,
  .shopee-btn:focus-visible {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  .shopee-btn__icon {
    flex: none;
  }
</style>
