---
import { Image } from "astro:assets";
import { images, type ImageSlug } from "../lib/images";
import type { Section } from "../lib/content-types";

interface Props {
  items: Section[];
}

const { items } = Astro.props;
---

<section class="quick-teasers">
  <div class="container quick-teasers__grid" style={`--cols: ${items.length}`}>
    {
      items.map((item, i) => (
        <a href={item.ctaHref ?? "#"} class="quick-teaser">
          {item.image && (
            <span
              class="quick-teaser__thumb"
              data-thumb-rotator={
                item.images && item.images.length > 1 ? "true" : undefined
              }
            >
              {(item.images && item.images.length > 1
                ? item.images
                : [item.image]
              ).map((slug, si) => (
                <Image
                  class="quick-teaser__thumb-img"
                  data-thumb-slide
                  data-active={si === 0 ? "true" : "false"}
                  src={images[slug as ImageSlug]}
                  alt=""
                  widths={[380, 560, 760]}
                  sizes="(min-width: 700px) 30vw, 90vw"
                  loading="lazy"
                />
              ))}
            </span>
          )}
          <span class="quick-teaser__index" aria-hidden="true">
            0{i + 1}
          </span>
          <span class="quick-teaser__label eyebrow">{item.label}</span>
          <span class="quick-teaser__headline font-heading">
            {item.headline}
          </span>
          {item.teaser && (
            <span class="quick-teaser__teaser">{item.teaser}</span>
          )}
          {item.cta && (
            <span class="quick-teaser__cta">
              <span class="quick-teaser__cta-label">{item.cta}</span>
              <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
                <path
                  d="M1 6H17M17 6L12 1M17 6L12 11"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          )}
        </a>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll("[data-thumb-rotator]").forEach((thumb) => {
    const slides = Array.from(thumb.querySelectorAll("[data-thumb-slide]"));
    if (slides.length < 2) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (prefersReducedMotion) return;

    let index = 0;
    setInterval(() => {
      slides[index]?.setAttribute("data-active", "false");
      index = (index + 1) % slides.length;
      slides[index]?.setAttribute("data-active", "true");
    }, 3000);
  });
</script>

<style>
  .quick-teasers__grid {
    display: grid;
    gap: var(--space-md);
    padding-block: var(--space-md);
  }

  .quick-teaser {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .quick-teaser__thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: var(--space-sm);
    background: var(--color-surface);
  }

  .quick-teaser__thumb :global(.quick-teaser__thumb-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s var(--ease-standard), transform var(--duration-base) var(--ease-out);
  }

  .quick-teaser__thumb :global(.quick-teaser__thumb-img[data-active="true"]) {
    opacity: 1;
  }

  .quick-teaser:hover .quick-teaser__thumb :global(.quick-teaser__thumb-img[data-active="true"]) {
    transform: scale(1.04);
  }

  .quick-teaser__index {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-small);
    color: color-mix(in srgb, var(--color-ink) 35%, transparent);
    margin-bottom: var(--space-sm);
  }

  .quick-teaser__label {
    margin-bottom: var(--space-3xs);
  }

  .quick-teaser__headline {
    font-size: var(--text-h3);
    line-height: var(--leading-snug);
    color: var(--color-primary);
    max-width: 24ch;
    margin-bottom: var(--space-3xs);
    white-space: pre-line;
  }

  .quick-teaser__teaser {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .quick-teaser__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
    padding-bottom: 0.3em;
    border-bottom: var(--border-width) solid var(--color-primary);
    align-self: flex-start;
    margin-top: auto;
    transition: gap var(--duration-fast) var(--ease-standard);
  }

  .quick-teaser__cta svg {
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .quick-teaser:hover .quick-teaser__cta svg,
  .quick-teaser:focus-visible .quick-teaser__cta svg {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-teaser:hover .quick-teaser__thumb :global(.quick-teaser__thumb-img) {
      transform: none;
    }
    .quick-teaser:hover .quick-teaser__cta svg {
      transform: none;
    }
  }

  @media (min-width: 700px) {
    .quick-teasers__grid {
      grid-template-columns: repeat(var(--cols, 3), 1fr);
      gap: var(--space-xl);
      padding-block: var(--space-lg);
    }
  }
</style>
