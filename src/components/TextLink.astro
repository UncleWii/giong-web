---
interface Props {
  href: string;
  tone?: "primary" | "inverse";
  class?: string;
}
const { href, tone = "primary", class: className = "" } = Astro.props;
---

<a href={href} class:list={["text-link", `text-link--${tone}`, className]}>
  <span class="text-link__label"><slot /></span>
  <svg
    class="text-link__arrow"
    width="18"
    height="12"
    viewBox="0 0 18 12"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M1 6H17M17 6L12 1M17 6L12 11"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</a>

<style>
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-weight: 700;
    font-size: var(--text-small);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 0.3em;
    border-bottom: var(--border-width) solid currentColor;
    transition: gap var(--duration-fast) var(--ease-standard);
  }

  .text-link--primary {
    color: var(--color-primary);
  }

  .text-link--inverse {
    color: var(--color-accent);
  }

  .text-link__arrow {
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .text-link:hover .text-link__arrow,
  .text-link:focus-visible .text-link__arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .text-link:hover .text-link__arrow {
      transform: none;
    }
  }
</style>
