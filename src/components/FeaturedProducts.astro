---
// Khối "Cà phê rang xay nguyên chất" cho trang quán: 3 thẻ sản phẩm nhỏ gọn (cùng cỡ với thẻ món) + ô Zalo mua lẻ.
// Tên, dòng, hạt, hương vị, giá, link Shopee đều đọc từ src/lib/products.ts (không gõ tay).
// Ảnh: ưu tiên ảnh gói nền trắng src/assets/products/nen-trang/<slug>-nen-trang.webp (800×800);
// chưa có file thì dùng ảnh gói tách nền của sản phẩm, đặt trên thẻ trắng.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ShopeeButton from "./ShopeeButton.astro";
import { formatPrice, productUrl, type Product } from "../lib/products";

interface Props {
  products: Product[];
  title: string;
  lead?: string;
  /** Giá trị chi_nhanh gửi kèm sự kiện, vd. "NhaTrang" (chỉ dùng ở trang quán). */
  chiNhanh?: string;
  /** Giá trị vi_tri gửi kèm sự kiện. */
  viTri?: string;
  detailLabel: string;
  vatNote: string;
  zaloLabel: string;
  zaloNote: string;
  zaloHref: string;
  /** Bản dịch (en / ko): chữ trên nút, nhãn, định dạng giá và chữ riêng từng sản phẩm. Không truyền = tiếng Việt. */
  text?: {
    shopee: string;
    shopeeAria: string;
    productAlt: string;
    notes: string;
    currency: string;
    thousands: string;
    overrides?: Record<string, { bean?: string; notes?: string[] }>;
  };
}

const { products, title, lead, chiNhanh, viTri = "trang_quan_san_pham", detailLabel, vatNote, zaloLabel, zaloNote, zaloHref, text } = Astro.props;

const price = (vnd: number) =>
  text ? `${new Intl.NumberFormat("en-US").format(vnd).replace(/,/g, text.thousands)}${text.currency}` : formatPrice(vnd);

const whiteFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/products/nen-trang/*-nen-trang.{webp,jpg,png}", {
  eager: true,
});
const whiteBg = (slug: string) =>
  Object.entries(whiteFiles).find(([path]) => path.includes(`/${slug}-nen-trang.`))?.[1].default;
---

<section class="container fp" aria-labelledby="fp-title" data-vi-tri={viTri}>
  <h2 id="fp-title" class="font-heading fp__title">{title}</h2>
  {lead && <p class="fp__lead">{lead}</p>}

  <ul class="fp__grid">
    {
      products.map((p) => {
        const packshot = whiteBg(p.slug);
        return (
          <li class="fp-card">
            <div class="fp-card__media">
              <Image
                src={packshot ?? p.image}
                alt={text ? text.productAlt.replace("{name}", p.name).replace("{series}", p.seriesTitle) : `Gói cà phê ${p.name} – ${p.seriesTitle}`}
                widths={[200, 320, 480]}
                sizes="(min-width: 900px) 240px, 45vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="fp-card__name font-heading">{p.name}</h3>
            <p class="fp-card__meta">
              <span class="fp-card__series">{p.seriesTitle}</span>
              <span>{text?.overrides?.[p.slug]?.bean ?? p.bean}</span>
              <span>{text?.notes ?? "Hương vị"}: {(text?.overrides?.[p.slug]?.notes ?? p.notes).join(", ")}</span>
            </p>
            <p class="fp-card__price">
              <strong>{price(p.price)}</strong>
              <small>{vatNote}</small>
            </p>
            <div class="fp-card__actions">
              <ShopeeButton product={p} chiNhanh={chiNhanh} label={text?.shopee} ariaLabel={text ? text.shopeeAria.replace("{name}", p.name) : undefined} />
              <a
                class="fp-card__detail"
                href={productUrl(p)}
                data-track="xem_chi_tiet_sp"
                data-product-id={p.slug}
                data-chi-nhanh={chiNhanh}
              >
                {detailLabel}
              </a>
            </div>
          </li>
        );
      })
    }
    <li class="fp-zalo">
      <p class="fp-zalo__note">{zaloNote}</p>
      <a
        class="fp-zalo__btn"
        href={zaloHref}
        target="_blank"
        rel="noopener noreferrer"
        data-track="click_zalo"
        data-loai="le"
      >
        {zaloLabel}
      </a>
    </li>
  </ul>
</section>

<style>
  .fp {
    padding-block: var(--space-md);
  }

  .fp__title {
    font-size: var(--text-h2);
    color: var(--color-primary);
    margin-bottom: var(--space-3xs);
  }

  .fp__lead {
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-bottom: var(--space-sm);
  }

  /* Thanh trượt ngang (giống "Không gian quán"): thẻ nhỏ, vuốt/cuộn sang trái để xem thêm. */
  .fp__grid {
    display: flex;
    gap: var(--space-2xs);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    margin-inline: calc(var(--gutter) * -1);
    padding: 0 var(--gutter) var(--space-2xs);
    scrollbar-width: thin;
  }

  .fp-card,
  .fp-zalo {
    flex: 0 0 168px;
    scroll-snap-align: start;
  }

  .fp-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    padding: var(--space-3xs);
    background: #fff;
    border: 1px solid var(--color-border);
  }

  .fp-card__media {
    position: relative;
    height: 116px;
    overflow: hidden;
    background: #fff;
  }

  .fp-card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .fp-card__name {
    font-size: 1.05rem;
    line-height: 1.15;
    color: var(--color-primary);
  }

  .fp-card__meta {
    display: grid;
    gap: 0.1em;
    font-size: 0.74rem;
    line-height: 1.3;
    color: var(--color-text-muted);
  }

  .fp-card__series {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .fp-card__price {
    display: grid;
    margin-top: auto;
    padding-top: var(--space-3xs);
  }

  .fp-card__price strong {
    font-size: 1.05rem;
  }

  .fp-card__price small {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .fp-card__actions {
    display: grid;
    gap: 0.1em;
  }

  .fp-card__actions :global(.shopee-btn) {
    width: 100%;
    min-height: 36px;
    padding: 0.4em 0.4em;
    font-size: 0.76rem;
    gap: 0.4em;
  }

  .fp-card__detail {
    justify-self: center;
    padding: 0.4em 0.6em;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--color-primary);
    text-underline-offset: 0.2em;
  }

  .fp-zalo {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs);
    text-align: center;
    background: var(--color-paper-deep);
  }

  .fp-zalo__note {
    font-weight: 700;
    color: var(--color-primary);
  }

  .fp-zalo__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5em 1em;
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    color: var(--color-primary);
    border: var(--border-width) solid var(--color-primary);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .fp-zalo__btn:hover,
  .fp-zalo__btn:focus-visible {
    color: var(--color-accent);
    background: var(--color-primary);
  }

  @media (min-width: 900px) {
    .fp__grid {
      margin-inline: 0;
      padding-inline: 0;
    }

    .fp-card,
    .fp-zalo {
      flex-basis: 196px;
    }

    .fp-card__media {
      height: 132px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-zalo__btn {
      transition: none;
    }
  }
</style>
