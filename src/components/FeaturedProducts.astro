---
// Khối "Cà phê rang xay nguyên chất" cho trang quán: 3 thẻ sản phẩm nhỏ gọn (cùng cỡ với thẻ món) + ô Zalo mua lẻ.
// Tên, dòng, hạt, hương vị, giá, link Shopee đều đọc từ src/lib/products.ts (không gõ tay).
// Ảnh: ưu tiên ảnh gói nền trắng src/assets/products/nen-trang/<slug>-nen-trang.webp (800×800);
// chưa có file thì dùng ảnh gói tách nền của sản phẩm, đặt trên thẻ trắng.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ShopeeButton from "./ShopeeButton.astro";
import { formatPrice, productUrl, type Product } from "../lib/products";

interface Props {
  products: Product[];
  title: string;
  lead: string;
  /** Giá trị chi_nhanh gửi kèm sự kiện, vd. "NhaTrang". */
  chiNhanh: string;
  /** Giá trị vi_tri gửi kèm sự kiện. */
  viTri?: string;
  detailLabel: string;
  vatNote: string;
  zaloLabel: string;
  zaloNote: string;
  zaloHref: string;
}

const { products, title, lead, chiNhanh, viTri = "trang_quan", detailLabel, vatNote, zaloLabel, zaloNote, zaloHref } = Astro.props;

const whiteFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/products/nen-trang/*-nen-trang.{webp,jpg,png}", {
  eager: true,
});
const whiteBg = (slug: string) =>
  Object.entries(whiteFiles).find(([path]) => path.includes(`/${slug}-nen-trang.`))?.[1].default;
---

<section class="container fp" aria-labelledby="fp-title">
  <h2 id="fp-title" class="font-heading fp__title">{title}</h2>
  <p class="fp__lead">{lead}</p>

  <ul class="fp__grid">
    {
      products.map((p) => {
        const packshot = whiteBg(p.slug);
        return (
          <li class="fp-card">
            <div class="fp-card__media">
              <Image
                src={packshot ?? p.image}
                alt={`Gói cà phê ${p.name} – ${p.seriesTitle}`}
                widths={[200, 320, 480]}
                sizes="(min-width: 900px) 240px, 45vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="fp-card__name font-heading">{p.name}</h3>
            <p class="fp-card__meta">
              <span class="fp-card__series">{p.seriesTitle}</span>
              <span>{p.bean}</span>
              <span>Hương vị: {p.notes.join(", ")}</span>
            </p>
            <p class="fp-card__price">
              <strong>{formatPrice(p.price)}</strong>
              <small>{vatNote}</small>
            </p>
            <div class="fp-card__actions">
              <ShopeeButton product={p} chiNhanh={chiNhanh} viTri={viTri} />
              <a
                class="fp-card__detail"
                href={productUrl(p)}
                data-track="xem_chi_tiet_sp"
                data-product-id={p.slug}
                data-chi-nhanh={chiNhanh}
                data-vi-tri={viTri}
              >
                {detailLabel}
              </a>
            </div>
          </li>
        );
      })
    }
    <li class="fp-zalo">
      <p class="fp-zalo__note">{zaloNote}</p>
      <a
        class="fp-zalo__btn"
        href={zaloHref}
        target="_blank"
        rel="noopener noreferrer"
        data-track="click_zalo"
        data-loai="le"
        data-vi-tri={viTri}
      >
        {zaloLabel}
      </a>
    </li>
  </ul>
</section>

<style>
  .fp {
    padding-block: var(--space-md);
  }

  .fp__title {
    font-size: var(--text-h2);
    color: var(--color-primary);
    margin-bottom: var(--space-3xs);
  }

  .fp__lead {
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-bottom: var(--space-sm);
  }

  /* Cùng lưới với thẻ món: 2 cột trên điện thoại, 4 cột từ máy tính bảng (3 sản phẩm + ô Zalo). */
  .fp__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-xs);
  }

  .fp-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-width: 0;
    padding: var(--space-2xs);
    background: #fff;
    border: 1px solid var(--color-border);
  }

  .fp-card__media {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: #fff;
  }

  .fp-card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .fp-card__name {
    font-size: var(--text-body-lg);
    line-height: 1.15;
    color: var(--color-primary);
  }

  .fp-card__meta {
    display: grid;
    gap: 0.1em;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .fp-card__series {
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .fp-card__price {
    display: grid;
    margin-top: auto;
    padding-top: var(--space-3xs);
  }

  .fp-card__price strong {
    font-size: var(--text-body-lg);
  }

  .fp-card__price small {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .fp-card__actions {
    display: grid;
    gap: 0.1em;
  }

  .fp-card__actions :global(.shopee-btn) {
    width: 100%;
    min-height: 40px;
    padding: 0.45em 0.6em;
    font-size: 0.8rem;
    gap: 0.4em;
  }

  .fp-card__detail {
    justify-self: center;
    padding: 0.55em 0.6em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    text-underline-offset: 0.2em;
  }

  .fp-zalo {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs);
    text-align: center;
    background: var(--color-paper-deep);
  }

  .fp-zalo__note {
    font-weight: 700;
    color: var(--color-primary);
  }

  .fp-zalo__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5em 1em;
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    color: var(--color-primary);
    border: var(--border-width) solid var(--color-primary);
    transition: background var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }

  .fp-zalo__btn:hover,
  .fp-zalo__btn:focus-visible {
    color: var(--color-accent);
    background: var(--color-primary);
  }

  @media (min-width: 640px) {
    .fp__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-zalo__btn {
      transition: none;
    }
  }
</style>
