---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
// import ContactWidget from "../components/ContactWidget.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Open Graph type: "article" for blog posts. */
  ogType?: "website" | "article";
}

const { title, description, image = "/og-default.jpg", ogType = "website" } = Astro.props;
const siteName = "Gióng";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#8a181a" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="vi_VN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Bỏ qua đến nội dung chính</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* Tạm tắt widget liên hệ nổi: bỏ dấu comment để bật lại */}
    {/* <ContactWidget /> */}
  </body>
</html>
