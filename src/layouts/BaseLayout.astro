---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ZaloFloat from "../components/ZaloFloat.astro";
import LangSuggest from "../components/LangSuggest.astro";
import type { Alternates, Lang } from "../lib/lang";

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Open Graph type: "article" for blog posts, "product" for product pages. */
  ogType?: "website" | "article" | "product";
  /** Nhóm nội dung để đo lường Meta ViewContent: "cau_chuyen" | "hanh_trinh_thien_ly" | "farm" | "kien_thuc". */
  pageCategory?: "cau_chuyen" | "hanh_trinh_thien_ly" | "farm" | "kien_thuc";
  /** Tiêu đề đã có sẵn tên thương hiệu (vd. trang từng quán) → không thêm hậu tố " · Gióng". */
  brandedTitle?: boolean;
  /** Ngôn ngữ trang (mặc định vi). */
  lang?: Lang;
  /** Các bản ngôn ngữ của cùng trang (đường dẫn). Có thì hiện nút chọn ngôn ngữ, thanh gợi ý và thẻ hreflang. */
  alternates?: Alternates;
}

const { title, description, image = "/og-default.jpg", ogType = "website", pageCategory, brandedTitle = false, lang = "vi", alternates = {} } = Astro.props;
const ogLocale = { vi: "vi_VN", en: "en_US", ko: "ko_KR" } as const;
const altEntries = Object.entries(alternates) as [Lang, string][];
const hasAlternates = altEntries.length > 1;
const siteName = "Gióng";
const fullTitle = brandedTitle || title === siteName ? title : `${title} · ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#8a181a" />
    <link rel="canonical" href={canonicalURL} />
    {hasAlternates && altEntries.map(([l, path]) => <link rel="alternate" hreflang={l} href={new URL(path, Astro.site)} />)}
    {hasAlternates && alternates.vi && <link rel="alternate" hreflang="x-default" href={new URL(alternates.vi, Astro.site)} />}
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {hasAlternates && altEntries.filter(([l]) => l !== lang).map(([l]) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <slot name="head" />
  </head>
  <body data-page-category={pageCategory}>
    <a href="#main" class="skip-link">Bỏ qua đến nội dung chính</a>
    <Header lang={lang} alternates={alternates} />
    <LangSuggest lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ZaloFloat />
    <script>
      import "../lib/tracking";
      import "../lib/debug-placeholders";
    </script>
  </body>
</html>
