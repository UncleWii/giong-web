# Mã theo dõi (công khai, không phải bí mật). Đặt cùng tên ở Vercel > Settings > Environment Variables nếu muốn đổi.
# Không đặt thì web dùng đúng 2 mã mặc định bên dưới.
PUBLIC_META_PIXEL_ID=2234096230469629
PUBLIC_GA4_ID=G-XJDS7W9MTZ
# "false" = tắt hoàn toàn mọi theo dõi.
PUBLIC_TRACKING_ENABLED=true

# Google Ads (tùy chọn, bỏ trống = không dùng). Điền mã tài khoản dạng AW-1234567890 và nhãn chuyển đổi
# của từng hành động (lấy ở Google Ads > Mục tiêu > Chuyển đổi > chi tiết > Thẻ Google).
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GADS_LABEL_CHI_DUONG=
PUBLIC_GADS_LABEL_GOI=
PUBLIC_GADS_LABEL_ZALO=
PUBLIC_GADS_LABEL_MUA_NGAY=
